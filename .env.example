APP_ENV=dev
REGION=IN
LANGUAGE=en
DATABASE_URL=postgresql+psycopg://ada:ada@postgres:5432/ada
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ada-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
DECISION_PROVIDER=rules        # rules | claude | jev
# Task queue: "Analyse with Laya" queues the CSV; the GPU machine runs the model and polls
# /api/v1/taskoutput (python -m ada.workers.task_poller). The web server never loads Laya.
# Same value on the API and on the model machine. Make one: python -c "import secrets; print(secrets.token_urlsafe(48))"
TASK_WORKER_KEY=              # blank = queue off (worker endpoints answer 503)
TASK_LEASE_SECONDS=900        # a claimed task goes back to the queue after this (worker crashed)
TASK_EXPIRE_MINUTES=30        # unfinished after this = failed, so the user isn't left waiting
JEV_API_KEY=
JEV_BASE_URL=
ESCALATION_THRESHOLD=0.6
RUN_SPEND_CAP_USD=5
SENTRY_DSN=
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
